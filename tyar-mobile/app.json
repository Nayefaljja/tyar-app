{
  "expo": {
    "name": "TYAR | تيار",
    "slug": "tyar-ev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f2744"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tyar.ev",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0f2744"
      },
      "package": "com.tyar.ev",
      "versionCode": 1,
      "permissions": ["INTERNET", "VIBRATE"]
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": ["expo-font"],
    "extra": {
      "eas": {
        "projectId": "tyar-ev"
      }
    }
  }
}
